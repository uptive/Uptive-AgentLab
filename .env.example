# Copy to .env (gitignored) and fill in. Loaded by the Electron main process.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.aa9mnvb.mongodb.net/?appName=Cluster0
# Optional, defaults to "agentlab"
MONGODB_DB=

# Claude Code bridge: lets Claude Code (see .mcp.json) list flows and start runs in the open app.
# Off unless set. Use a random value of 32+ characters, e.g. `openssl rand -hex 32`, and export the
# same value in the shell you start Claude Code from.
# AGENTLAB_MCP_TOKEN=
# AGENTLAB_MCP_PORT=4780

{
  "name": "@agentlab/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist dist-electron release",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:win": "pnpm build && electron-builder --win"
  },
  "dependencies": {
    "@agentlab/agent-runtime": "workspace:*",
    "@agentlab/contracts": "workspace:*",
    "@agentlab/flow-engine": "workspace:*",
    "@agentlab/observability": "workspace:*",
    "@agentlab/optimization": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@xyflow/react": "^12.11.6",
    "ajv": "^8.20.0",
    "mongodb": "^6.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "se.uptive.agentlab",
    "productName": "AgentLab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}

{
  "name": "@agentlab/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist dist-electron release",
    "package:mac": "pnpm build && node scripts/copy-claude-binary.mjs && electron-builder --mac --publish never",
    "package:win": "pnpm build && node scripts/copy-claude-binary.mjs && electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@agentlab/agent-runtime": "workspace:*",
    "@agentlab/contracts": "workspace:*",
    "@agentlab/flow-engine": "workspace:*",
    "@agentlab/observability": "workspace:*",
    "@agentlab/optimization": "workspace:*",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@xyflow/react": "^12.11.6",
    "ajv": "^8.20.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "se.uptive.agentlab",
    "productName": "AgentLab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "extraResources": [
      {
        "from": "build/claude",
        "to": "claude"
      }
    ],
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "AgentLab-mac-${arch}.${ext}",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "AgentLab-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "afterPack": "scripts/adhoc-sign.cjs"
  }
}
